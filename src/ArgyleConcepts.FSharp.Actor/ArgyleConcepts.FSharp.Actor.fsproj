<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <PackageId>ArgyleConcepts.FSharp.Actor</PackageId>
        <PackageVersion>$(ArgylePackageVersion)</PackageVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Authors>Argyle Concepts</Authors>
        <Company>Argyle Concepts</Company>
        <Description>An Elm-style actor for F#: a single-threaded update loop over a Channel mailbox, with asynchronous commands, model-driven subscriptions, and an async stream of external messages.</Description>
        <PackageTags>fsharp;actor;elm;mvu;channels;task</PackageTags>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/ArgyleConcepts/FSharp.Actor</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ArgyleConcepts/FSharp.Actor</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
        <Compile Include="Actor.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="9.0.303"/>
    </ItemGroup>

</Project>
